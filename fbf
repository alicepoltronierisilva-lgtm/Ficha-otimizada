<body>

    <h1 style="text-align: center;">-- Registro de Agente --</h1>

    <div class="container">
        <div class="card">
            <h2>Dados do Agente</h2>
            <div class="form-group">
                <label>Nome do Agente:</label>
                <input type="text" placeholder="Ex: Joui Jouki">
            </div>
            <div style="display: flex; gap: 10px;">
                <div class="form-group" style="flex: 1;">
                    <label>Classe:</label>
                    <input type="text" placeholder="Ex: Combatente">
                </div>
                <div class="form-group" style="flex: 1;">
                    <label>NEX:</label>
                    <input type="text" placeholder="Ex: 15%">
                </div>
            </div>

            <h3>Status Vital</h3>
            <div class="stats-grid">
                <div class="stat-box pv">
                    <label style="color: var(--danger-red);">PV A/M</label>
                    <input type="number" id="pv-atual" value="20"> / 
                    <input type="number" id="pv-max" value="20">
                </div>
                <div class="stat-box san">
                    <label style="color: var(--san-blue);">SAN A/M</label>
                    <input type="number" id="san-atual" value="15"> / 
                    <input type="number" id="san-max" value="15">
                </div>
                <div class="stat-box pe">
                    <label style="color: var(--pe-green);">PE A/M</label>
                    <input type="number" id="pe-atual" value="5"> / 
                    <input type="number" id="pe-max" value="5">
                </div>
            </div>

            <h3>Atributos</h3>
            <div class="attributes">
                <div class="attr-box">
                    <label>AGI</label>
                    <input type="number" id="attr-agi" value="1">
                </div>
                <div class="attr-box">
                    <label>FOR</label>
                    <input type="number" id="attr-for" value="1">
                </div>
                <div class="attr-box">
                    <label>INT</label>
                    <input type="number" id="attr-int" value="1">
                </div>
                <div class="attr-box">
                    <label>PRE</label>
                    <input type="number" id="attr-pre" value="1">
                </div>
                <div class="attr-box">
                    <label>VIG</label>
                    <input type="number" id="attr-vig" value="1">
                </div>
            </div>
        </div>

        <div class="card dice-section">
            <h2>Terminal de Rolagem</h2>
            
            <div class="dice-controls">
                <div class="form-group">
                    <label>Qtd. de Dados (D20):</label>
                    <input type="number" id="dice-count" value="1" min="1">
                </div>
                <div class="form-group">
                    <label>Tipo de Dado:</label>
                    <select id="dice-type">
                        <option value="20">d20 (Testes)</option>
                        <option value="6">d6 (Dano/Efeitos)</option>
                        <option value="8">d8 (Dano)</option>
                        <option value="10">d10 (Dano)</option>
                        <option value="12">d12 (Dano)</option>
                        <option value="100">d100 (Porcentagem)</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>Bônus / Perícia (+/-):</label>
                <input type="number" id="dice-bonus" value="0">
            </div>

            <button onclick="rollDice()">Rolar Dados</button>

            <div class="result-box">
                <div class="result-details" id="roll-details">Aguardando rolagem...</div>
                <div class="result-total" id="roll-total">-</div>
            </div>

            <h3>Histórico de Testes</h3>
            <div class="history" id="history-log">
                </div>
        </div>
    </div>

    <script>
        function rollDice() {
            const count = parseInt(document.getElementById('dice-count').value) || 1;
            const sides = parseInt(document.getElementById('dice-type').value);
            const bonus = parseInt(document.getElementById('dice-bonus').value) || 0;

            let rolls = [];
            for (let i = 0; i < count; i++) {
                rolls.push(Math.floor(Math.random() * sides) + 1);
            }

            let total = 0;
            let detailsText = "";

            // Regra Ordem Paranormal para d20: pega o MAIOR dado.
            // Para outros dados (como dano), soma todos os dados.
            if (sides === 20) {
                const bestRoll = Math.max(...rolls);
                total = bestRoll + bonus;
                detailsText = `Dados: [${rolls.join(', ')}] | Maior: ${bestRoll} | Bônus: ${bonus >= 0 ? '+' : ''}${bonus}`;
            } else {
                const sum = rolls.reduce((a, b) => a + b, 0);
                total = sum + bonus;
                detailsText = `Dados: [${rolls.join(' + ')}] | Bônus: ${bonus >= 0 ? '+' : ''}${bonus}`;
            }

            // Atualiza o Display principal
            document.getElementById('roll-total').innerText = total;
            document.getElementById('roll-details').innerText = detailsText;

            // Adiciona ao Histórico
            const historyLog = document.getElementById('history-log');
            const newEntry = document.createElement('div');
            newEntry.className = 'history-item';
            newEntry.innerHTML = `<strong>${total}</strong> <small>(${count}d${sides}${bonus >= 0 ? '+' : ''}${bonus}) → ${detailsText}</small>`;
            historyLog.prepend(newEntry);
        }
    </script>
